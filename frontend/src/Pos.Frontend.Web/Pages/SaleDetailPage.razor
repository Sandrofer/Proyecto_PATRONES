@page "/sales/{Id:int}"
@inject IPosApi Api
@inject IJSRuntime JS

<PageTitle>Detalle de venta</PageTitle>

<AuthGuard>
    <div class="detail-actions no-print">
        <a class="back" href="sales"><Icon Name="back" /> Volver al historial</a>
        @if (sale is not null)
        {
            <button class="btn primary" @onclick="PrintAsync"><Icon Name="receipt" /> Imprimir comprobante</button>
        }
    </div>
    <Alert Message="@error" />
    @if (sale is null && error is null)
    {
        <div class="empty"><span class="spinner dark"></span><p>Consultando Odoo…</p></div>
    }
    else if (sale is not null)
    {
        <PrintableReceipt Sale="sale" />
        <section class="panel ticket no-print">
            <header class="ticket-head">
                <span class="brand-mark"><Icon Name="coffee" Size="20" /></span>
                <div>
                    <h2>@sale.Name</h2>
                    <p class="muted small">@sale.DateOrderUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · Id Odoo @sale.Id</p>
                </div>
                <span class="badge @Ui.StatusClass(sale.State)">@Ui.StatusLabel(sale.State)</span>
            </header>

            <div class="meta-row">
                <div><span class="muted small">Cliente</span><strong>@(sale.CustomerName ?? "Consumidor final")</strong>
                    @if (sale.CustomerIdentification is not null) { <span class="muted small">C.I. @sale.CustomerIdentification</span> }</div>
                <div><span class="muted small">Cajero</span><strong>@(sale.CashierName ?? "—")</strong></div>
                <div><span class="muted small">Sesión de caja</span><strong>@(sale.SessionName ?? "—")</strong></div>
            </div>

            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Producto</th><th class="num">Cant.</th><th class="num">Precio</th><th class="num">Desc.</th><th class="num">Sin IVA</th><th class="num">Con IVA</th></tr></thead>
                    <tbody>
                        @foreach (var l in sale.Lines)
                        {
                            <tr>
                                <td>@l.ProductName</td>
                                <td class="num">@Ui.Qty(l.Quantity)</td>
                                <td class="num">@Ui.Money(l.UnitPrice)</td>
                                <td class="num">@(l.DiscountPercent > 0 ? l.DiscountPercent.ToString("0.##") + " %" : "—")</td>
                                <td class="num">@Ui.Money(l.SubtotalWithoutTax)</td>
                                <td class="num"><strong>@Ui.Money(l.SubtotalWithTax)</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="totals">
                <div><span>Subtotal</span><span>@Ui.Money(sale.AmountTotal - sale.AmountTax)</span></div>
                <div><span>IVA</span><span>@Ui.Money(sale.AmountTax)</span></div>
                <div class="grand"><span>Total</span><span>@Ui.Money(sale.AmountTotal)</span></div>
                @foreach (var p in sale.Payments.Where(p => !p.IsChange))
                {
                    <div class="payment"><span>Recibido · @p.PaymentMethodName</span><span>@Ui.Money(p.Amount)</span></div>
                }
                @if (sale.AmountReturn > 0)
                {
                    <div class="payment change"><span>Vuelto</span><span>@Ui.Money(sale.AmountReturn)</span></div>
                }
            </div>
        </section>
    }
</AuthGuard>

@code {
    [Parameter] public int Id { get; set; }
    // ?imprimir=1 opens the print dialog as soon as the sale is loaded (button "Imprimir" after charging).
    [SupplyParameterFromQuery(Name = "imprimir")] public int? AutoPrint { get; set; }
    SaleDetailDto? sale;
    string? error;
    bool printed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (AutoPrint == 1 && sale is not null && !printed)
        {
            printed = true;
            await PrintAsync();
        }
    }

    async Task PrintAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("print");
        }
        catch (JSException)
        {
            error = "El navegador no permitió abrir la impresión. Use Ctrl + P.";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetSaleAsync(Id);
        sale = result.Value;
        error = result.IsSuccess ? null : result.Error;
    }
}
