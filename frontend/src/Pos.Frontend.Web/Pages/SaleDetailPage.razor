@page "/sales/{Id:int}"
@inject IPosApi Api

<PageTitle>Detalle de venta</PageTitle>

<AuthGuard>
    <section class="panel">
        <header class="panel-head">
            <h2>Venta @(sale?.Name ?? Id.ToString())</h2>
            <a class="btn small" href="sales">Volver</a>
        </header>
        <Alert Message="@error" />
        @if (sale is not null)
        {
            <p>
                Id Odoo <strong>@sale.Id</strong> · @sale.DateOrderUtc.ToLocalTime().ToString("g") ·
                sesión @sale.SessionName · estado <span class="badge">@sale.State</span>
            </p>
            <table class="table">
                <thead><tr><th>Producto</th><th class="num">Cantidad</th><th class="num">Precio</th><th class="num">Desc. %</th><th class="num">Sin impuestos</th><th class="num">Con impuestos</th></tr></thead>
                <tbody>
                    @foreach (var l in sale.Lines)
                    {
                        <tr>
                            <td>@l.ProductName</td>
                            <td class="num">@l.Quantity.ToString("0.##")</td>
                            <td class="num">@l.UnitPrice.ToString("N2")</td>
                            <td class="num">@l.DiscountPercent.ToString("0.##")</td>
                            <td class="num">@l.SubtotalWithoutTax.ToString("N2")</td>
                            <td class="num">@l.SubtotalWithTax.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="totals">
                <div><span>Impuestos</span><span>@sale.AmountTax.ToString("N2")</span></div>
                <div class="grand"><span>Total</span><span>@sale.AmountTotal.ToString("N2")</span></div>
                @foreach (var p in sale.Payments)
                {
                    <div><span>Pago: @p.PaymentMethodName</span><span>@p.Amount.ToString("N2")</span></div>
                }
            </div>
        }
    </section>
</AuthGuard>

@code {
    [Parameter] public int Id { get; set; }
    SaleDetailDto? sale;
    string? error;

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetSaleAsync(Id);
        sale = result.Value;
        error = result.IsSuccess ? null : result.Error;
    }
}
