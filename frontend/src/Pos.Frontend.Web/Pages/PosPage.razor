@page "/"
@inject IPosApi Api
@inject CheckoutUseCase Checkout
@inject IAuthSession Auth
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Punto de venta</PageTitle>

<AuthGuard>
    <div class="pos-grid">
        <section class="panel catalog">
            <header class="panel-head">
                <div>
                    <h2>Productos</h2>
                    <p class="muted small">Precios e impuestos vienen de Odoo</p>
                </div>
                @if (session is not null)
                {
                    <span class="badge ok"><span class="dot"></span> @session.Name</span>
                }
                else if (sessionError is not null)
                {
                    <span class="badge error"><span class="dot"></span> @sessionError</span>
                }
            </header>

            <form class="search" @onsubmit="SearchAsync">
                <Icon Name="search" Class="search-icon" />
                <input @bind="search" maxlength="@InputRules.MaxSearchLength" placeholder="Buscar por nombre o código…" aria-label="Buscar producto" />
                <button type="submit" class="btn" disabled="@searching">Buscar</button>
            </form>

            <Alert Message="@catalogError" />

            @if (searching)
            {
                <div class="product-grid">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="product-card skeleton"></div>
                    }
                </div>
            }
            else if (products.Count == 0)
            {
                <div class="empty"><Icon Name="search" Size="32" /><p>No hay productos que coincidan.</p></div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var p in products)
                    {
                        var inCart = Checkout.Cart.Lines.FirstOrDefault(l => l.Product.Id == p.Id)?.Quantity;
                        var soldOut = p.QuantityAvailable is decimal av && av - (inCart ?? 0) <= 0;
                        <button type="button" class="product-card @(inCart is not null ? "selected" : "") @(soldOut ? "sold-out" : "")"
                                disabled="@(Locked || soldOut)" @onclick="() => Add(p)"
                                title="@(soldOut ? (inCart is null ? "Agotado" : "Ya agregó todo el stock") : "Agregar " + p.Name)">
                            @if (p.QuantityAvailable is <= 0)
                            {
                                <span class="sold-out-tag">Agotado</span>
                            }
                            @if (inCart is not null)
                            {
                                <span class="in-cart">@Ui.Qty(inCart.Value)</span>
                            }
                            <span class="product-img">
                                @if (p.ImageDataUrl is not null)
                                {
                                    <img src="@p.ImageDataUrl" alt="" />
                                }
                                else
                                {
                                    <Icon Name="coffee" Size="28" />
                                }
                            </span>
                            <span class="product-name">@p.Name</span>
                            <span class="product-meta">@(p.Code ?? "sin código") · IVA @p.TaxPercent.ToString("0.##") %</span>
                            <span class="product-foot">
                                <strong>@Ui.Money(p.UnitPrice)</strong>
                                <span class="stock @(p.QuantityAvailable is > 0 and <= 5 ? "low" : "")">@(p.QuantityAvailable is null ? "stock s/d" : Ui.Qty(p.QuantityAvailable.Value) + " disp.")</span>
                            </span>
                        </button>
                    }
                </div>
            }
        </section>

        <section class="panel cart">
            <header class="panel-head">
                <div>
                    <h2><Icon Name="cart" /> Venta actual</h2>
                    <p class="muted small">@Checkout.Cart.Lines.Count producto(s)</p>
                </div>
            </header>

            @if (Checkout.Cart.IsEmpty)
            {
                <div class="empty"><Icon Name="cart" Size="32" /><p>Toque un producto para agregarlo.</p></div>
            }
            else
            {
                <ul class="cart-lines">
                    @foreach (var line in Checkout.Cart.Lines)
                    {
                        var pid = line.Product.Id;
                        var qty = line.Quantity;
                        <li>
                            <div class="cart-info">
                                <span class="cart-name">@line.Product.Name</span>
                                <span class="muted small">@Ui.Money(line.Product.UnitPrice) c/u</span>
                            </div>
                            <div class="stepper">
                                <button class="icon-btn" disabled="@(Locked || qty <= 1)" aria-label="Restar"
                                        @onclick="() => Run(() => Checkout.Cart.SetQuantity(pid, qty - 1))"><Icon Name="minus" Size="14" /></button>
                                <input @key="(pid, qtyRender)" inputmode="numeric" maxlength="4" value="@qty" disabled="@Locked"
                                       @onchange="e => ChangeQuantity(pid, e.Value)" aria-label="Cantidad" />
                                <button class="icon-btn" disabled="@(Locked || Pos.Frontend.Domain.Cart.RemainingStock(line.Product, qty) is <= 0)" aria-label="Sumar"
                                        @onclick="() => Run(() => Checkout.Cart.SetQuantity(pid, qty + 1))"><Icon Name="plus" Size="14" /></button>
                            </div>
                            <span class="cart-sub">@Ui.Money(quote?.Lines.FirstOrDefault(q => q.ProductId == pid)?.SubtotalWithTax ?? line.Subtotal)</span>
                            <button class="icon-btn danger" disabled="@Locked" @onclick="() => Remove(pid)" aria-label="Quitar"><Icon Name="trash" Size="15" /></button>
                        </li>
                    }
                </ul>
            }
            <Alert Message="@cartError" />

            <fieldset class="customer">
                <legend><Icon Name="user" Size="15" /> Cliente</legend>
                <div class="segmented">
                    <button type="button" class="@(Checkout.CustomerRequired ? "" : "on")" disabled="@Locked" @onclick="() => SetCustomerMode(false)">Consumidor final</button>
                    <button type="button" class="@(Checkout.CustomerRequired ? "on" : "")" disabled="@Locked" @onclick="() => SetCustomerMode(true)">Con cédula</button>
                </div>
                @if (Checkout.CustomerRequired)
                {
                    <div class="form-grid tight">
                        <label class="field">
                            <span>Cédula</span>
                            <input value="@Checkout.CustomerIdentification" inputmode="numeric" maxlength="10" placeholder="1710034065"
                                   disabled="@Locked" class="@CedulaClass" @onchange="ChangeCedulaAsync" />
                        </label>
                        <label class="field">
                            <span>Nombre</span>
                            <input value="@Checkout.CustomerName" placeholder="Nombre y apellido" maxlength="@InputRules.MaxNameLength" disabled="@Locked"
                                   @onchange="ChangeCustomerName" />
                        </label>
                    </div>
                    @if (customerHint is not null)
                    {
                        <p class="hint ok"><Icon Name="check" Size="14" /> @customerHint</p>
                    }
                    <Alert Message="@CustomerError" Kind="warn" />
                }
            </fieldset>

            <div class="form-grid">
                <label class="field">
                    <span>Descuento</span>
                    <select value="@Checkout.DiscountPolicyCode" disabled="@Locked" @onchange="ChangePolicy">
                        @foreach (var policy in policies)
                        {
                            <option value="@policy.Code">@policy.Description</option>
                        }
                    </select>
                </label>
                @if (SelectedPolicy?.RequiresPercent == true)
                {
                    <label class="field">
                        <span>Porcentaje</span>
                        <input inputmode="decimal" maxlength="5" placeholder="@($"0 – {SelectedPolicy.MaxPercent:0.##}")" disabled="@Locked"
                               value="@Checkout.DiscountPercent" @onchange="ChangePercent" />
                    </label>
                }
                <label class="field">
                    <span>Método de pago</span>
                    <select @bind="paymentMethodId" disabled="@Locked">
                        <option value="0">Seleccione…</option>
                        @foreach (var m in session?.PaymentMethods ?? [])
                        {
                            <option value="@m.Id" disabled="@(!m.IsCash)">@m.Name@(m.IsCash ? "" : " (no admitido)")</option>
                        }
                    </select>
                </label>
            </div>
            <Alert Message="@DiscountError" Kind="warn" />

            @{
                decimal discountShown = quote?.DiscountPercent ?? Checkout.ProvisionalDiscountPercent;
                var provisional = Checkout.Cart.CalculateTotals(discountShown);
            }
            <div class="totals">
                <div><span>Subtotal</span><span>@Ui.Money(quote?.AmountUntaxed ?? provisional.Untaxed)</span></div>
                <div><span>IVA</span><span>@Ui.Money(quote?.AmountTax ?? provisional.Tax)</span></div>
                @if (discountShown > 0)
                {
                    <div class="discount"><span>Descuento aplicado</span><span>@discountShown.ToString("0.##") %</span></div>
                }
                <div class="grand">
                    <span>Total <small class="@(quote is null ? "tag" : "tag ok")">@(quote is null ? "provisional" : "verificado")</small></span>
                    <span>@Ui.Money(quote?.AmountTotal ?? provisional.Total)</span>
                </div>
            </div>

            <Alert Message="@checkoutMessage" Kind="@checkoutKind" />

            <div class="actions">
                @if (Checkout.PendingOperation is not null)
                {
                    <button class="btn" disabled="@busy" @onclick="Discard">Descartar</button>
                    <button class="btn primary" disabled="@busy" @onclick="ConfirmAsync"><Icon Name="refresh" /> Reintentar</button>
                }
                else
                {
                    <button class="btn" disabled="@(busy || BlockingError is not null)" title="@BlockingError" @onclick="QuoteAsync">Verificar total</button>
                    <button class="btn primary big" disabled="@(busy || session is null || BlockingError is not null)" title="@BlockingError" @onclick="ConfirmAsync">
                        @if (busy)
                        {
                            <span class="spinner"></span> <span>Registrando…</span>
                        }
                        else
                        {
                            <Icon Name="check" /> <span>Cobrar @Ui.Money(quote?.AmountTotal ?? provisional.Total)</span>
                        }
                    </button>
                }
            </div>

            @if (lastRegistration is { OrderId: not null })
            {
                <div class="receipt">
                    <Icon Name="receipt" Size="22" />
                    <div>
                        <strong>@lastRegistration.OrderName</strong>
                        <span class="muted small">@Ui.StatusLabel(lastRegistration.State) · @Ui.Money(lastRegistration.AmountTotal)</span>
                    </div>
                    <a class="btn small" href="sales/@lastRegistration.OrderId">Ver detalle</a>
                </div>
            }
        </section>
    </div>
</AuthGuard>

@code {
    string? search;
    bool searching, busy;
    List<ProductDto> products = [];
    List<DiscountPolicyDto> policies = [];
    PosSessionDto? session;
    SaleQuoteDto? quote;
    SaleRegistrationDto? lastRegistration;
    int paymentMethodId;
    string? sessionError, catalogError, cartError, checkoutMessage;
    string checkoutKind = "error";

    bool Locked => busy || Checkout.PendingOperation is not null;
    int qtyRender;
    string? customerHint;
    bool percentNotNumber;

    // Live validation: the message appears as soon as the data is wrong, and
    // Verificar/Cobrar stay disabled until it is fixed.
    string? CustomerError => Checkout.CustomerRequired ? Checkout.ValidateCustomer() : null;
    string? DiscountError => Checkout.Cart.IsEmpty ? null
        : percentNotNumber ? "El porcentaje de descuento debe ser un número, por ejemplo 5 o 7.5."
        : Checkout.ValidateDiscount();
    string? BlockingError => percentNotNumber ? DiscountError : Checkout.ValidateBeforeSending(paymentMethodId);

    string CedulaClass => string.IsNullOrEmpty(Checkout.CustomerIdentification) ? ""
        : Pos.Frontend.Domain.Cedula.IsValid(Checkout.CustomerIdentification.Trim()) ? "valid" : "invalid";

    void SetCustomerMode(bool on)
    {
        Checkout.CustomerRequired = on;
        customerHint = cartError = null;
        quote = null;
        if (!on)
        {
            Checkout.CustomerIdentification = "";
            Checkout.CustomerName = "";
        }
    }

    void ChangeCustomerName(ChangeEventArgs e)
    {
        Checkout.CustomerName = e.Value?.ToString() ?? "";
        quote = null;
    }

    // Validates the cedula and, if the customer already exists in Odoo, fills the name.
    async Task ChangeCedulaAsync(ChangeEventArgs e)
    {
        Checkout.CustomerIdentification = (e.Value?.ToString() ?? "").Trim();
        customerHint = null;
        quote = null;
        if (!Pos.Frontend.Domain.Cedula.IsValid(Checkout.CustomerIdentification))
            return; // CustomerError shows the reason
        var found = await Api.FindCustomerAsync(Checkout.CustomerIdentification);
        if (found.Value is not null)
        {
            Checkout.CustomerName = found.Value.Name;
            customerHint = "Cliente encontrado en Odoo.";
        }
        else if (found.StatusCode == 404)
            customerHint = "Cliente nuevo: se creará en Odoo al cobrar.";
    }
    DiscountPolicyDto? SelectedPolicy => Checkout.SelectedPolicy;

    protected override async Task OnInitializedAsync()
    {
        Checkout.Cart.Changed += OnCartChanged;
        if (!Auth.IsAuthenticated) return;

        var sessionTask = Api.GetActiveSessionAsync();
        var policiesTask = Api.GetDiscountPoliciesAsync();
        await SearchAsync();

        var s = await sessionTask;
        session = s.Value;
        sessionError = s.IsSuccess ? null : s.Error;
        paymentMethodId = session?.PaymentMethods.FirstOrDefault(m => m.IsCash)?.Id ?? 0;

        var p = await policiesTask;
        policies = p.Value?.ToList() ?? [];
        Checkout.Policies = policies;
    }

    async Task SearchAsync()
    {
        if (InputRules.ValidateSearch(search) is string searchError)
        {
            catalogError = searchError;
            return;
        }
        searching = true;
        var result = await Api.SearchProductsAsync(search);
        products = result.Value?.ToList() ?? [];
        catalogError = result.IsSuccess ? null : result.Error;
        searching = false;
    }

    void Add(ProductDto p) => Run(() => Checkout.Cart.Add(p.ToCartProduct()));
    void Remove(int productId) => Run(() => Checkout.Cart.Remove(productId));

    void ChangeQuantity(int productId, object? value)
    {
        // Accept "2" or "2.0"; a comma is a decimal mark, never a thousands separator ("1,5" is not 15).
        string text = (value?.ToString() ?? "").Trim().Replace(',', '.');
        if (!decimal.TryParse(text, System.Globalization.NumberStyles.AllowDecimalPoint,
                System.Globalization.CultureInfo.InvariantCulture, out var qty) || qty <= 0)
        {
            cartError = "La cantidad debe ser un número mayor que cero.";
            qtyRender++;
            return;
        }
        Run(() => Checkout.Cart.SetQuantity(productId, qty));
    }

    void ChangePolicy(ChangeEventArgs e)
    {
        Checkout.DiscountPolicyCode = e.Value?.ToString() ?? "NONE";
        Checkout.DiscountPercent = null;
        percentNotNumber = false;
        checkoutMessage = cartError = null;
        quote = null;
    }

    void ChangePercent(ChangeEventArgs e)
    {
        quote = null;
        checkoutMessage = null;
        string text = (e.Value?.ToString() ?? "").Trim().Replace(',', '.');
        percentNotNumber = text.Length > 0 && !decimal.TryParse(text, System.Globalization.NumberStyles.AllowDecimalPoint,
            System.Globalization.CultureInfo.InvariantCulture, out _);
        Checkout.DiscountPercent = !percentNotNumber && text.Length > 0
            ? decimal.Parse(text, System.Globalization.CultureInfo.InvariantCulture) : null;
    }

    void Run(Action action)
    {
        try
        {
            action();
            cartError = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            cartError = ex.Message;
            qtyRender++; // redraw the input with the real quantity
        }
    }

    async Task QuoteAsync()
    {
        busy = true;
        var result = await Checkout.QuoteAsync(paymentMethodId);
        quote = result.Value;
        (checkoutMessage, checkoutKind) = result.IsSuccess ? ("Total verificado con los precios de Odoo.", "ok") : (result.FullError, "error");
        busy = false;
    }

    async Task ConfirmAsync()
    {
        busy = true;
        checkoutMessage = null;
        var result = await Checkout.ConfirmAsync(paymentMethodId);
        checkoutMessage = result.Message;
        checkoutKind = result.Success ? "ok" : result.Uncertain ? "warn" : "error";
        if (result.Success)
        {
            lastRegistration = result.Registration;
            SetCustomerMode(false);
            quote = null;
            await SearchAsync();
        }
        busy = false;
    }

    void Discard()
    {
        Checkout.Reset();
        checkoutMessage = "Operación descartada. Revise el historial antes de volver a cobrar.";
        checkoutKind = "warn";
    }

    void OnCartChanged()
    {
        quote = null;
        StateHasChanged();
    }

    public void Dispose() => Checkout.Cart.Changed -= OnCartChanged;
}
