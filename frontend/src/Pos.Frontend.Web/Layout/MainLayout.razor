@inherits LayoutComponentBase
@inject IAuthSession Auth
@inject CheckoutUseCase Checkout
@inject NavigationManager Nav

@if (Auth.IsAuthenticated)
{
    <header class="topbar">
        <a class="brand" href="">
            <span class="brand-mark"><Icon Name="coffee" Size="20" /></span>
            <span>Cafetería UTA <small>POS · Odoo 20</small></span>
        </a>
        <nav class="tabs">
            <NavLink href="" Match="NavLinkMatch.All"><Icon Name="store" /> Vender</NavLink>
            <NavLink href="sales"><Icon Name="history" /> Historial</NavLink>
        </nav>
        <div class="user">
            <span class="avatar">@Ui.Initials(Auth.OperatorName ?? "?")</span>
            <span class="user-name">@Auth.OperatorName</span>
            <button class="btn ghost-light small" @onclick="LogoutAsync" title="Cerrar sesión">
                <Icon Name="logout" /> <span class="hide-sm">Salir</span>
            </button>
        </div>
    </header>
}
<main class="@(Auth.IsAuthenticated ? "content" : "content bare")">
    @Body
</main>

@code {
    async Task LogoutAsync()
    {
        Checkout.Reset();
        await Auth.SignOutAsync();
        Nav.NavigateTo("login");
    }
}
